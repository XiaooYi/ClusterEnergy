server {
    listen $CE_WEB_PORT;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass http://$CE_GATEWAY_ADDR/api/;
        proxy_http_version 1.1;
        proxy_read_timeout 90s;
    }

    location = /healthz {
        proxy_pass http://$CE_GATEWAY_ADDR/healthz;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
